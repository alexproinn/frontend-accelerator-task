{
  "name": "training-sessions-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --mode assessment",
    "build": "tsc -b && vite build --mode assessment",
    "build:backend": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "msw": "2.14.6",
    "vitest": "^4.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^27.0.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.48.0",
    "eslint-plugin-react-hooks": "^7.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}